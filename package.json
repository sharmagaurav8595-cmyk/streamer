{
  "name": "streamloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal, server-powered YouTube streaming studio.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "setup:youtube": "node scripts/setup-youtube.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm run test && npm run build"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
}
