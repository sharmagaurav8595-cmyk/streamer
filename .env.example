# Local defaults. Copy to .env only if you want to change these.
PORT=3000
HOST=127.0.0.1
MAX_UPLOAD_GB=5
MAX_STORAGE_GB=20

# Public Docker hosting: domain pointing to your VPS, without https://.
# SITE_ADDRESS=stream.yourdomain.com
# Generate a hash with: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes are required around the hash in .env to preserve dollar signs.
# ADMIN_PASSWORD_HASH='$2a$14$replace_with_your_generated_hash'

# Optional: override the local FFmpeg / FFprobe executable locations.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Optional: use an existing yt-dlp executable instead of npm run setup:youtube.
# YT_DLP_PATH=C:/tools/yt-dlp.exe
